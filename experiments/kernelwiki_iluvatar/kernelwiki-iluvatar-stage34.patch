+    @staticmethod
+    def backward(ctx, g):
+        x, weights = ctx.saved_tensors
+        H = ctx.H
+        g = g.contiguous()
+        dx = torch.empty_like(x)
+        dw = torch.empty_like(weights)
+        numel = g.numel()
+        if numel != 0:
+            _launch_bwd_input(x, g, weights, dx, numel, H)
+            _launch_wgrad(x, g, dw, numel // H, H)
+        return dx, dw
+
+
+def weighted_swiglu(x, weights, *, native):
