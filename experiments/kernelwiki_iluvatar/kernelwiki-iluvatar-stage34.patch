+class _WeightedSwiGLU(torch.autograd.Function):
+    @staticmethod
+    def forward(ctx, x, weights):
+        H = x.shape[-1] // 2
+        out = torch.empty(x.shape[:-1] + (H,), dtype=x.dtype, device=x.device)
