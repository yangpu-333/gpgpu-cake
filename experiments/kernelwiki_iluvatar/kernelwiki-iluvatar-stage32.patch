+              'gradnorm_candidate_sha256': c.sha(c.GRAD / 'candidate.py'), 'swiglu_candidate_sha256': None,
+              'validator_adaptation': validator_adaptation, 'model': contract['model'],
+              'seeds': seeds, 'orders': c.ORDERS, 'pairs': [], 'completed_cases': [],
+              'promotion_rule': {'gain_vs_control_strictly_greater_than': 0.01,
+                                 'all_three_seeds_faster_vs_control': True}, 'started_utc': c.utc(),
+              'scope': 'Fresh declared held-out native/control/optimized BF16 mock-data GPT. '
+                       'Control CE0008+gradnorm001; optimized only adds frozen Attention003 without retuning. '
+                       'Original compiled SwiGLU, default fused softmax and native RMSNorm in every arm. '
+                       'Native GPU-synchronized time.time interval timer:120steps,first20excluded,ten '
+                       'log-interval10 records retained. No audit/profile/checkpoint/eval during timing. '
+                       'Original softmax route APIs and native SwiGLU are proved by bound untimed audit; '
+                       'timing has equal main-Attention dispatch observation, live configuration/binary '
+                       'provenance and actual four ScriptFunction graph hashes. No extra original softmax '
+                       'or SwiGLU call wrappers during timing, no per-call native route observation, '
+                       'GPU timeline, production, convergence or multiGPU claim.'}
+    try:
+        for seed, order in zip(seeds, c.ORDERS):
+            arms = {}
+            for arm in order:
+                folder = folders[(seed, arm)]
+                expected = c.command_for(folder, arm, args.version, contract_path, contract, 120, seed)
+                validator.EXPECTED_COMMANDS[str(folder)] = expected
+                record = c.run_case(folder, arm, args.model, args.version, contract_path, contract, 120, seed)
+                result = validator.validate_case(folder, record['mode'], seed, contract,
+                                                 c.sha(contract_path), c.sha(c.BF / 'candidates/0008/candidate.py'))
+                result.update(stage32_arm=arm, hooks=c.hook_gate(folder, arm, args.version, contract,
+                                                               120, manifest, provenance['backend']))
+                c.require(tuple(row['iteration'] for row in result['intervals'] if row['iteration'] != 1)
