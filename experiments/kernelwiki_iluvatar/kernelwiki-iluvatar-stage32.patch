+                                 and hooks['optimized']['attention']['candidate_sha256'] == c.CANDIDATE_SHA
+                                 and hooks['optimized']['attention']['fallback_calls'] == 0)
+                    name = 'Identical CE0008/gradnorm001 control and native SwiGLU; only Attention003 differs'
