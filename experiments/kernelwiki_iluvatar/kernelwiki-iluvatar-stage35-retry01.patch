+                    candidate=Path(name)
+                    assert candidate.resolve().is_relative_to(HERE.parent.resolve())
+                    verify(candidate,row);os.link(candidate,target);verify(target,row)
+                    reused=True;method='old_object_actual_bytes_verified_then_hardlinked';break
+                if not reused:
+                    partial=transport/(digest+'.reconstructed-'+str(time.time_ns())+'.partial')
+                    with partial.open('xb') as output:
+                        for piece in row['pieces']:
+                            p=pieces[piece]
+                            with (transport/p['pack']).open('rb') as source:
+                                source.seek(p['offset']);compressed=source.read(p['compressed_bytes'])
+                            assert hashlib.sha256(compressed).hexdigest()==p['compressed_sha256']
+                            decoder=zlib.decompressobj()
+                            data=decoder.decompress(compressed,p['bytes']+1)
+                            assert decoder.eof and not decoder.unused_data and not decoder.unconsumed_tail
+                            assert len(data)==p['bytes'] and hashlib.sha256(data).hexdigest()==piece
+                            output.write(data)
+                    verify(partial,row);os.link(partial,target);verify(target,row)
+                    method='byte_transport_reconstruction_original_sha_verified'
+            object_receipts.append({'sha256':digest,'bytes':row['bytes'],'method':method})
+            if index%20==0: print(json.dumps({'phase':'originals_reconstructed','verified_objects':index}),flush=True)
+        linked=[]
+        for row in plan['files']:
+            rel=PurePosixPath(row['relative_path'])
+            assert not rel.is_absolute() and '..' not in rel.parts and rel.parts[0] in ('long','experts')
+            assert row['path']==plan['remote_canonical_root']+rel.as_posix()
+            target=RAW.joinpath(*rel.parts)
+            assert target.resolve().is_relative_to(RAW.resolve()) and not target.is_symlink()
+            source=objects/row['sha256'];verify(source,row)
+            if target.exists(): verify(target,row)
+            else: target.parent.mkdir(parents=True,exist_ok=True);os.link(source,target);verify(target,row)
+            linked.append(dict(row,local_path=str(target),method='complete_original_sha_verified_hardlink'))
+        spec=importlib.util.spec_from_file_location('exact_retry01_cpu_reader',HERE/'verify_receipts_retry01_mount.py')
+        reader=importlib.util.module_from_spec(spec);spec.loader.exec_module(reader)
