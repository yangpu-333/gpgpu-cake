+        assert all(g['original_byte_coverage_complete'] is True for g in gates.values())
+        record={'schema':'stage35-recovery01-retry01-exact-raw-http-backup-receipt-v1',
+                'status':'all_384_originals_byte_verified','started_utc':started,'finished_utc':utc(),
+                'plan_sha256':PLAN_SHA,'receiver_sha256':sha(Path(__file__)),
