@@ -0,0 +1,131 @@
+"""Byte-only transport dedup: inspect ZIP offsets, never deserialize tensors/pickle."""
+from datetime import datetime, timezone
+import hashlib
+import json
+import os
+from pathlib import Path, PurePosixPath
+import re
+import struct
+import subprocess
+import zipfile
+import zlib
+
+ROOT = Path('/private/kda-biv150-stage35-recovery01')
+OUT = ROOT / 'raw-transport-retry01'
+PLAN_SHA = '93366e057a1814c484a6bc0f7baa3bb05b5e21c8fb59faa5a2c58e8fbd3ea6cb'
+sha_bytes = lambda value: hashlib.sha256(value).hexdigest()
+utc = lambda: datetime.now(timezone.utc).isoformat()
+
+
+def sha_file(path):
+    h = hashlib.sha256()
+    with path.open('rb') as stream:
+        for block in iter(lambda: stream.read(1048576), b''): h.update(block)
+    return h.hexdigest()
+
+
+def occupancy():
+    gpu = subprocess.run(['/usr/local/corex/bin/ixsmi'], capture_output=True, text=True, timeout=20)
+    ps = subprocess.run(['ps', '-eo', 'pid,ppid,user,etimes,pcpu,pmem,comm'], capture_output=True, text=True, timeout=20)
+    devices = re.findall(r'(\d+)MiB\s*/\s*32768MiB\s*\|\s*(\d+)%', gpu.stdout)
+    foreign = []
+    for line in ps.stdout.splitlines()[1:]:
+        f = line.split()
+        if len(f) >= 7 and int(f[0]) != os.getpid() and (f[6].startswith(('python','torchrun','triton')) or float(f[4]) >= 10):
+            foreign.append({'pid': int(f[0]), 'command': f[6], 'cpu_percent': float(f[4])})
+    record = {'utc': utc(), 'gpu_stdout': gpu.stdout, 'process_stdout': ps.stdout, 'foreign_compute': foreign,
+              'both_gpus_idle': len(devices) == 2 and all(int(m) <= 256 and int(u) == 0 for m,u in devices)
+                  and 'No running processes found' in gpu.stdout}
+    assert gpu.returncode == ps.returncode == 0 and record['both_gpus_idle'] and not foreign
+    return record
+
+
+def main():
+    assert ROOT.resolve() == Path('/mnt/kda-biv150-stage35-recovery01')
+    plan_path = ROOT / 'raw-http-transfer-plan-retry01-01.json'
+    assert sha_file(plan_path) == PLAN_SHA
+    plan = json.loads(plan_path.read_text())
+    assert plan['file_count'] == len(plan['files']) == 384
+    assert len(plan['objects']) == 227
+    before_occupancy = occupancy()
+    OUT.mkdir()
+    pieces, originals, packs = {}, [], []
+    current = None
+    chunk_size = pack_size = 8 * 1024 * 1024
+    def close_pack():
+        nonlocal current
+        if current:
+            current.flush(); os.fsync(current.fileno()); current.close()
+            path = OUT / ('pack-%04d.bin' % len(packs))
+            packs[-1].update(bytes=path.stat().st_size, sha256=sha_file(path))
+            current = None
+    def store(data):
+        nonlocal current
+        digest = sha_bytes(data)
+        if digest in pieces:
+            assert pieces[digest]['bytes'] == len(data)
+            return digest
+        compressed = zlib.compress(data, level=1)
+        if current is None or (current.tell() and current.tell() + len(compressed) > pack_size):
+            close_pack()
+            name = 'pack-%04d.bin' % (len(packs) + 1)
+            current = (OUT / name).open('xb')
+            packs.append({'name': name})
+        offset = current.tell()
+        current.write(compressed)
+        pieces[digest] = {'bytes': len(data), 'pack': packs[-1]['name'], 'offset': offset,
+                          'compressed_bytes': len(compressed), 'compressed_sha256': sha_bytes(compressed)}
+        return digest
+    for index, row in enumerate(plan['objects'], 1):
+        rel = PurePosixPath(row['representative_relative_path'])
+        assert not rel.is_absolute() and '..' not in rel.parts
+        assert rel.parts[0] in ('long','experts') and rel.parts[1] in ('native-admission01','control-admission01','optimized-audit004')
+        path = ROOT.joinpath('models-retry01', *rel.parts)
+        assert path.resolve().is_relative_to((ROOT/'models-retry01').resolve()) and not path.is_symlink()
+        before = path.stat()
+        assert before.st_size == row['bytes'] and sha_file(path) == row['sha256']
+        boundaries = {0, row['bytes']}
+        if zipfile.is_zipfile(path):
+            with zipfile.ZipFile(path) as archive, path.open('rb') as stream:
+                for entry in archive.infolist():
+                    if entry.compress_type != zipfile.ZIP_STORED: continue
+                    stream.seek(entry.header_offset)
+                    header = stream.read(30)
+                    assert header[:4] == b'PK\x03\x04'
+                    name_length, extra_length = struct.unpack_from('<HH', header, 26)
+                    start = entry.header_offset + 30 + name_length + extra_length
+                    end = start + entry.file_size
+                    assert 0 <= start <= end <= row['bytes']
+                    boundaries.update((start,end))
+        sequence = []
+        with path.open('rb') as stream:
+            points = sorted(boundaries)
+            for start,end in zip(points, points[1:]):
+                stream.seek(start)
+                remaining = end-start
+                while remaining:
+                    data = stream.read(min(remaining, chunk_size))
+                    assert data
+                    sequence.append(store(data))
+                    remaining -= len(data)
+        after = path.stat()
+        assert (before.st_ino,before.st_size,before.st_mtime_ns) == (after.st_ino,after.st_size,after.st_mtime_ns)
+        assert sum(pieces[d]['bytes'] for d in sequence) == row['bytes']
+        originals.append({'sha256': row['sha256'], 'bytes': row['bytes'], 'pieces': sequence})
+        if index % 20 == 0: print(json.dumps({'phase':'packaging', 'original_objects':index,'unique_pieces':len(pieces),'packs':len(packs)}), flush=True)
