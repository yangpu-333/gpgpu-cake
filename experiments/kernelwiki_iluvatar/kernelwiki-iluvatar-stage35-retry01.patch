+
+ROOT = Path(__file__).resolve().parent
+BF = Path('/tmp/kda-bf16-continuation/megatron_bf16')
+FORMAL = BF.parent/'megatron_training_entry'
+sha = lambda path: hashlib.sha256(Path(path).read_bytes()).hexdigest()
