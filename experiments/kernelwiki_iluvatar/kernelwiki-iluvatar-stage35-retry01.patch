+                print(json.dumps({'phase':'pack_verified','name':name,'bytes':row['bytes']}),flush=True)
+                return {'name':name,'method':'http_pack_sha_verified','sha256':row['sha256'],'bytes':row['bytes']}
+            record['failed_partial_retained']=str(partial)
+            write(attempts/(name+'-'+tag+'.json'),record)
+        raise RuntimeError('Four bounded pack transfers failed; partials retained: '+name)
+    print(json.dumps({'phase':'transport_start','packs':len(packs),'transport_bytes':manifest['transport_bytes'],'workers':3}),flush=True)
+    with (RAW/'receiver.lock').open('a+b') as lock:
+        if os.name == 'nt':
+            import msvcrt
+            lock.write(b'0');lock.flush();lock.seek(0);msvcrt.locking(lock.fileno(),msvcrt.LK_NBLCK,1)
+        else:
+            import fcntl
+            fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
