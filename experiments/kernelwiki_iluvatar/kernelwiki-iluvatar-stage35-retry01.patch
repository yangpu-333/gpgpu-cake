@@ -0,0 +1,119 @@
+"""Archive completed long primary originals without accepting the unresolved resource gate."""
+from concurrent.futures import ThreadPoolExecutor
+from datetime import datetime, timezone
+import hashlib
+import importlib.util
+import json
+from pathlib import Path, PurePosixPath
+import statistics
+import subprocess
+import zipfile
+
+ROOT = Path(__file__).resolve().parent.parent
+BASE = 'http://share.ai.ic.h3i.buaa.edu.cn/ai-exp-sy2506311-kda1-service-qpia/files/private/kda-biv150-stage35-recovery01/'
+sha = lambda data: hashlib.sha256(data).hexdigest()
+read = lambda p: json.loads(Path(p).read_text(encoding='utf-8'))
+perf_path = ROOT / 'results/long-performance-004-primary-diagnostic.json'
+wrapper_path = ROOT / 'results/browser-formal-long-retry01-primary-01-current.json'
+perf, wrapper = read(perf_path), read(wrapper_path)
+assert perf['status'] == 'validated' and len(perf['completed_cases']) == 9
+assert wrapper['status'] == 'failed' and wrapper['exit_code'] == 0
+assert wrapper['error'] == 'Post-run resources busy; timing needs further examination'
+assert wrapper['occupancy_before']['passed'] is True
+assert wrapper['occupancy_after']['both_gpus_idle'] is True
+record_path = ROOT / 'evidence/long-primary-diagnostic-import-01.json'
+assert not record_path.exists()
+downloads = ROOT / 'results/long-primary-diagnostic-originals'
+rows = []
+payload = {}
+
+def add(origin, destination, expected=None, existing=None):
+    path = PurePosixPath(origin)
+    assert not path.is_absolute() and '..' not in path.parts
+    assert path.suffix in ('.json', '.log')
+    assert not any(word in path.name.lower() for word in ('ssh', 'token', 'password'))
+    rows.append({'origin_relative': origin, 'destination_relative': destination,
+                 'expected_sha256': expected, 'existing': existing})
+
+add('models-retry01/long/performance-004.json',
+    'models-retry01/long/evidence/performance-004.json', sha(perf_path.read_bytes()), perf_path)
+for pair in perf['pairs']:
+    for arm, case in pair['cases'].items():
+        assert case['case'] == f'{arm}-perf-004-{pair["seed"]}'
+        assert pair['seed'] in (35102, 35103, 35104)
+        digests = {**case['raw_sha256'], **case['dispatch_sha256']}
+        assert set(digests) == {'command.json', 'entry.json', 'stdout.log', 'stderr.log',
+                                'weighted.json', 'gradnorm.json'}
+        for name, digest in digests.items():
+            origin = 'models-retry01/long/' + case['case'] + '/' + name
+            destination = 'models-retry01/long/evidence/' + case['case'] + '/' + name
+            add(origin, destination, digest)
+for name in ('browser-formal-long-retry01-primary-01.json',
+             'browser-formal-long-retry01-primary-01.stdout.log',
+             'browser-formal-long-retry01-primary-01.stderr.log',
+             'browser-preformal-occupancy-retry01-02.json'):
+    add(name, 'evidence/retry01-metadata/root/' + name,
+        sha(wrapper_path.read_bytes()) if name.endswith('primary-01.json') else None,
+        wrapper_path if name.endswith('primary-01.json') else None)
+
+def fetch(row):
+    if row['existing'] is not None:
+        data = row['existing'].read_bytes()
+    else:
+        target = downloads / row['origin_relative']
+        target.parent.mkdir(parents=True, exist_ok=True)
+        process = subprocess.run(['curl.exe', '-q', '--fail', '--silent', '--show-error',
+            '--connect-timeout', '8', '--max-time', '20', '--noproxy', 'share.ai.ic.h3i.buaa.edu.cn',
+            '--proto', '=http', '--output', str(target), BASE + row['origin_relative']],
+            capture_output=True, text=True, timeout=25)
+        assert process.returncode == 0, (row['origin_relative'], process.stderr)
+        data = target.read_bytes()
+    digest = sha(data)
+    assert row['expected_sha256'] is None or digest == row['expected_sha256'], row['origin_relative']
+    return row, data, digest
+
+with ThreadPoolExecutor(max_workers=4) as pool:
+    originals = list(pool.map(fetch, rows))
+assert len(originals) == 59
+for row, data, digest in originals:
+    destination = ROOT / row['destination_relative']
+    if destination.exists():
+        assert destination.read_bytes() == data, row['destination_relative']
+    else:
+        destination.parent.mkdir(parents=True, exist_ok=True)
+        with destination.open('xb') as stream:
+            stream.write(data)
+    payload['payload/' + row['origin_relative']] = data
+    del row['existing']
+    row.update(bytes=len(data), sha256=digest)
+
+spec = importlib.util.spec_from_file_location('fresh_long_receipt_reader', ROOT / 'verify_receipts_retry01_mount.py')
+verifier = importlib.util.module_from_spec(spec)
+spec.loader.exec_module(verifier)
+verified = verifier.verify('long', require_raw=True)
+assert all(r['native_control_equal'] and r['native_optimized_equal']
+           for r in verified['loss_print_comparisons'])
+cv = {arm: statistics.stdev(p['cases'][arm]['mean_iteration_ms'] for p in perf['pairs']) /
+           statistics.mean(p['cases'][arm]['mean_iteration_ms'] for p in perf['pairs'])
+      for arm in ('native', 'control', 'optimized')}
+record = {'schema': 'retry01-long-primary-diagnostic-import-v1',
+          'created_utc': datetime.now(timezone.utc).isoformat(),
+          'status': 'original_logs_and_numerical_receipts_verified_resource_gate_unresolved',
+          'files': rows, 'file_count': len(rows), 'cpu_receipt_validation': verified,
+          'seed_mean_cv': cv, 'repeat_required_by_cv': any(cv[a] >= .1 for a in ('native', 'control')),
+          'post_run_resource_gate_accepted': False, 'accepted_for_skill_release': False,
+          'foreign_or_residual_process_state_known': False,
+          'original_failed_wrapper_preserved': True,
+          'collector_sha256': sha(Path(__file__).read_bytes()),
+          'scope': 'No GPU rerun. Original completed nine-process timing and three-step GPU audit receipts; post-run process status still requires independent verification.'}
+archive_path = ROOT / 'results/metadata-retry01-long-primary-diagnostic-01.zip'
+with zipfile.ZipFile(archive_path, 'x', compression=zipfile.ZIP_DEFLATED) as archive:
+    for name, data in sorted(payload.items()):
+        archive.writestr(name, data)
+    archive.writestr('manifest.json', json.dumps(record, indent=2) + '\n')
+record['archive_sha256'] = sha(archive_path.read_bytes())
+with record_path.open('x', encoding='utf-8', newline='\n') as stream:
+    stream.write(json.dumps(record, indent=2) + '\n')
+print(json.dumps({'status': record['status'], 'files': len(rows),
+                  'vs_control': verified['vs_control'], 'vs_native': verified['vs_native'],
+                  'seed_mean_cv': cv, 'resource_gate_accepted': False}))
