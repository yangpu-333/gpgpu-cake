+"""Receive exact current-round raw files from the authorized Jupyter artifact root.
+
+At most three bounded curl workers; no browser state, cookies, passwords or keys.
+Partial transfers and failed attempt receipts stay in this owned ignored namespace.
+"""
+import argparse
+from concurrent.futures import ThreadPoolExecutor, wait, FIRST_COMPLETED
+from datetime import datetime, timezone
+import hashlib
+import importlib.util
+import json
+import os
+from pathlib import Path, PurePosixPath
+import re
+import shutil
+import subprocess
+import threading
+import time
+from urllib.parse import quote, urlsplit
+
+HERE = Path(__file__).resolve().parent.parent
+RAW = HERE / 'evidence/raw-backup-retry01'
+URL_ROOT = 'http://share.ai.ic.h3i.buaa.edu.cn/ai-exp-sy2506311-kda1-service-qpia/files/private/kda-biv150-stage35-recovery01/models-retry01/'
+REMOTE = '/mnt/kda-biv150-stage35-recovery01/models-retry01/'
+SHA_CACHE, HASH_LOCK, PRINT_LOCK = {}, threading.Lock(), threading.Lock()
+utc = lambda: datetime.now(timezone.utc).isoformat()
+
+def emit(value):
+    with PRINT_LOCK:
+        print(json.dumps(value), flush=True)
+
+def sha_file(path):
+    before = path.stat()
+    key = (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
+    with HASH_LOCK:
+        if key in SHA_CACHE:
+            return SHA_CACHE[key]
+    h = hashlib.sha256()
+    with path.open('rb') as stream:
+        for block in iter(lambda: stream.read(1048576), b''):
+            h.update(block)
+    after = path.stat()
+    assert (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns) == key, 'File changed while hashing'
+    value = h.hexdigest()
+    with HASH_LOCK:
+        SHA_CACHE[key] = value
+    return value
+
+def write_new(path, value):
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open('x', encoding='utf-8', newline='\n') as stream:
+        json.dump(value, stream, indent=2)
+        stream.write('\n')
+
+def verify_object(path, row):
+    assert path.is_file() and not path.is_symlink()
+    assert path.stat().st_size == row['bytes'] and sha_file(path) == row['sha256'], 'Raw size/SHA mismatch: ' + str(path)
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--manifest', type=Path, default=HERE / 'evidence/raw-http-transfer-plan-retry01-01.json')
+    parser.add_argument('--plan-sha256', required=True)
+    parser.add_argument('--workers', type=int, choices=(1, 2, 3), default=3)
+    parser.add_argument('--idle-acknowledged', action='store_true', help='Required after a fresh two-GPU/CPU idle check; no formal timing during transfer')
+    args = parser.parse_args()
+    assert args.idle_acknowledged, 'Fresh idle check and no concurrent formal timing required'
+    assert sha_file(args.manifest) == args.plan_sha256, 'Immutable plan bytes differ'
+    plan = json.loads(args.manifest.read_text(encoding='utf-8'))
+    assert plan['schema'] == 'stage35-recovery01-retry01-exact-raw-http-plan-v1'
+    assert plan['url_root'] == URL_ROOT and plan['remote_canonical_root'] == REMOTE
+    assert plan['file_count'] == 384 and len(plan['files']) == 384
+    assert len(plan['objects']) == plan['unique_objects'] and plan['complete_raw_backup'] is False
+    assert all(not (HERE / 'models-retry01' / model / 'evidence/performance-004.json').exists() for model in ('long', 'experts'))
+    for relative, digest in plan['input_metadata_sha256'].items():
+        assert sha_file(HERE / relative) == digest
+    assert sha_file(HERE / 'evidence/local-metadata-import-retry01-01.json') == plan['metadata_import_sha256']
+    assert sha_file(HERE / 'results/browser-extra-raw-inventory-retry01-01.json') == plan['extra_raw_inventory_sha256']
+    assert sha_file(HERE / 'verify_receipts_retry01_mount.py') == plan['reader_sha256']
+    assert sha_file(HERE / 'evidence/retry01-metadata/root/browser-path-alias-retry01-01.json') == plan['alias_receipt_sha256']
+    receipt = HERE / 'evidence/raw-http-backup-retry01-01-receipt.json'
+    assert not receipt.exists(), 'Completed collection receipt is immutable'
+    objects, partials, attempts = RAW / 'objects', RAW / 'partials', RAW / 'transfer-attempts'
+    for directory in (RAW, objects, partials, attempts):
+        directory.mkdir(parents=True, exist_ok=True)
+        assert directory.resolve().is_relative_to(HERE.resolve())
+    ignore = RAW / '.gitignore'
+    if not ignore.exists():
+        with ignore.open('x', encoding='utf-8', newline='\n') as stream:
+            stream.write('*\n')
+    assert ignore.read_text(encoding='utf-8') == '*\n'
+    curl = shutil.which('curl.exe') or shutil.which('curl')
+    assert curl, 'curl executable required'
+    rows = {row['sha256']: row for row in plan['objects']}
+    assert len(rows) == plan['unique_objects']
+    for digest, row in rows.items():
+        assert re.fullmatch('[0-9a-f]{64}', digest) and type(row['bytes']) is int and row['bytes'] >= 0
+        relative = PurePosixPath(row['representative_relative_path'])
+        assert not relative.is_absolute() and '..' not in relative.parts
+        assert relative.parts[0] in ('long', 'experts') and relative.parts[1] in ('native-admission01', 'control-admission01', 'optimized-audit004')
+        assert relative.parts[2] in ('activation', 'routing', 'snapshots')
+        assert row['url'] == URL_ROOT + quote(relative.as_posix(), safe='/')
+        assert urlsplit(row['url']).netloc == 'share.ai.ic.h3i.buaa.edu.cn'
+    started = utc()
+    lock_path = RAW / 'receiver.lock'
+    with lock_path.open('a+b') as process_lock:
+        if os.name == 'nt':
+            import msvcrt
+            if process_lock.tell() == 0:
+                process_lock.write(b'0'); process_lock.flush()
+            process_lock.seek(0); msvcrt.locking(process_lock.fileno(), msvcrt.LK_NBLCK, 1)
+        else:
+            import fcntl
+            fcntl.flock(process_lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        results, failures = {}, []
+        def receive(row):
+            digest = row['sha256']; destination = objects / digest
+            if destination.exists():
+                verify_object(destination, row)
+                return {'sha256': digest, 'bytes': row['bytes'], 'method': 'existing_current_object_verified'}
+            for candidate_name in row['verified_reuse_candidates']:
+                candidate = Path(candidate_name)
+                assert candidate.resolve().is_relative_to(HERE.parent.resolve())
+                verify_object(candidate, row)
+                os.link(candidate, destination)
+                verify_object(destination, row)
+                return {'sha256': digest, 'bytes': row['bytes'], 'method': 'old_object_actual_bytes_verified_then_hardlinked', 'source': str(candidate)}
+            attempt_root = attempts / digest; attempt_root.mkdir(exist_ok=True)
+            prior = sorted(attempt_root.glob('attempt-*.json'))
+            ordinal = max([int(p.stem.split('-')[1]) for p in prior], default=0)
+            candidates = sorted(partials.glob(digest + '.part-*.partial'), key=lambda p: p.stat().st_size, reverse=True)
+            partial = next((p for p in candidates if p.stat().st_size <= row['bytes'] and not p.with_suffix('.rejected.json').exists()), None)
+            if partial is None:
+                partial = partials / (digest + '.part-%04d.partial' % (ordinal + 1))
+                with partial.open('xb'):
+                    pass
+            for local_attempt in range(4):
+                ordinal += 1
+                offset = partial.stat().st_size
+                assert offset <= row['bytes']
+                if offset == row['bytes']:
+                    if sha_file(partial) == digest:
+                        os.link(partial, destination)
+                        verify_object(destination, row)
+                        return {'sha256': digest, 'bytes': row['bytes'], 'method': 'http_original_verified', 'partial_kept': str(partial), 'attempts_this_run': local_attempt}
+                    write_new(partial.with_suffix('.rejected.json'), {'reason': 'full_size_wrong_sha_preserved', 'expected': digest, 'actual': sha_file(partial)})
+                    partial = partials / (digest + '.part-%04d.partial' % ordinal)
+                    if partial.exists():
+                        partial = partials / (digest + '.part-%04d-restart.partial' % ordinal)
+                    with partial.open('xb'):
+                        pass
+                    offset = 0
+                argv = [curl, '-q', '--fail', '--silent', '--show-error', '--connect-timeout', '15',
+                        '--max-time', '300', '--retry', '0', '--proto', '=http',
+                        '--noproxy', 'share.ai.ic.h3i.buaa.edu.cn', '--continue-at', '-',
+                        '--output', str(partial), '--write-out', '%{http_code}', row['url']]
+                begin = utc(); elapsed = time.monotonic()
+                try:
+                    process = subprocess.run(argv, text=True, capture_output=True, timeout=310)
+                    code, http, error = process.returncode, process.stdout.strip(), process.stderr
+                except subprocess.TimeoutExpired:
+                    code, http, error = 124, '', 'Local310-second subprocess guard; partial preserved'
+                record = {'sha256': digest, 'url': row['url'], 'offset_before': offset,
+                          'bytes_after': partial.stat().st_size, 'partial': str(partial),
+                          'started_utc': begin, 'finished_utc': utc(), 'elapsed_seconds': time.monotonic() - elapsed,
+                          'curl_exit_code': code, 'http_status': http, 'stderr': error,
+                          'cookies_or_credentials_supplied': False, 'redirects_followed': False}
+                write_new(attempt_root / ('attempt-%04d.json' % ordinal), record)
+                if partial.stat().st_size == row['bytes'] and sha_file(partial) == digest:
+                    os.link(partial, destination)
+                    verify_object(destination, row)
+                    return {'sha256': digest, 'bytes': row['bytes'], 'method': 'http_original_verified', 'partial_kept': str(partial), 'attempts_this_run': local_attempt + 1}
+                if code == 33 or (offset > 0 and http == '200') or partial.stat().st_size > row['bytes']:
+                    write_new(partial.with_suffix('.rejected.json'), {'reason': 'resume_unavailable_or_invalid_length_preserved', 'curl_exit_code': code, 'http_status': http})
+                    partial = partials / (digest + '.part-%04d-restart.partial' % (ordinal + 1))
+                    with partial.open('xb'):
+                        pass
+            raise RuntimeError('Four bounded attempts incomplete; all partials/attempt receipts retained for ' + digest)
+        emit({'phase': 'starting_exact_raw_collection', 'files': plan['file_count'], 'unique_objects': plan['unique_objects'],
+              'unique_bytes': plan['unique_bytes'], 'workers': args.workers, 'formal_timing_allowed': False})
+        with ThreadPoolExecutor(max_workers=args.workers) as executor:
+            futures = {executor.submit(receive, row): row for row in plan['objects']}
+            pending = set(futures)
+            while pending:
+                done, pending = wait(pending, timeout=20, return_when=FIRST_COMPLETED)
+                for future in done:
+                    row = futures[future]
+                    try:
+                        result = future.result(); results[row['sha256']] = result
+                        emit({'phase': 'object_verified', **result})
+                    except Exception as error:
+                        failures.append({'sha256': row['sha256'], 'error': str(error)})
+                        emit({'phase': 'object_incomplete', 'sha256': row['sha256'], 'error': str(error)})
+                if not done:
+                    emit({'phase': 'transfer_progress', 'verified_objects': len(results), 'pending_objects': len(pending),
+                          'incomplete_objects': len(failures), 'formal_timing_allowed': False})
+        if failures:
+            failed = attempts / ('run-incomplete-' + str(time.time_ns()) + '.json')
+            write_new(failed, {'started_utc': started, 'finished_utc': utc(), 'failures': failures,
+                               'verified_objects': len(results), 'formal_timing_barrier_released': False})
+            raise RuntimeError('Raw collection incomplete; resume same immutable plan; receipt ' + str(failed))
+        linked = []
+        for row in plan['files']:
+            rel = PurePosixPath(row['relative_path'])
+            assert row['path'] == REMOTE + rel.as_posix()
+            assert row['local_destination_relative'] == 'evidence/raw-backup-retry01/' + rel.as_posix()
+            target = RAW.joinpath(*rel.parts)
+            assert target.resolve().is_relative_to(RAW.resolve()) and not target.is_symlink()
+            source = objects / row['sha256']; verify_object(source, row)
+            if target.exists():
+                verify_object(target, row); method = 'existing_identical_original_retained'
+            else:
+                target.parent.mkdir(parents=True, exist_ok=True)
+                os.link(source, target); verify_object(target, row); method = 'verified_object_hardlink'
+            linked.append({'path': row['path'], 'logical_path': row['logical_path'], 'local_path': str(target),
+                           'bytes': row['bytes'], 'sha256': row['sha256'], 'method': method})
+        spec = importlib.util.spec_from_file_location('retry01_raw_complete_cpu_reader', HERE / 'verify_receipts_retry01_mount.py')
+        v = importlib.util.module_from_spec(spec); spec.loader.exec_module(v)
+        gates = {model: v.verify(model, audit_only=True, require_raw=True) for model in ('long', 'experts')}
+        assert all(result['original_byte_coverage_complete'] is True for result in gates.values())
+        record = {'schema': 'stage35-recovery01-retry01-exact-raw-http-backup-receipt-v1',
+                  'status': 'all_384_originals_byte_verified', 'started_utc': started, 'finished_utc': utc(),
+                  'plan_sha256': args.plan_sha256, 'receiver_sha256': sha_file(Path(__file__)),
+                  'original_file_count': len(linked), 'original_bytes': sum(row['bytes'] for row in linked),
+                  'unique_objects': len(rows), 'unique_bytes': sum(row['bytes'] for row in rows.values()),
+                  'objects': sorted(results.values(), key=lambda row: row['sha256']), 'files': linked,
+                  'cpu_numerical_receipt_gates': gates, 'complete_raw_backup': True,
+                  'formal_timing_barrier_released': True, 'raw_sources_modified': False,
+                  'existing_originals_overwritten': False, 'cookies_or_credentials_used': False,
+                  'network_workers_max': args.workers, 'gpu_work_executed': False,
+                  'scope': 'Complete byte archive of the new retry01 audit. Old identical objects supplied bytes only; all current metadata and fresh extra checkpoint identities remained unchanged.'}
+        write_new(receipt, record)
+        emit({'phase': 'complete', 'original_files': len(linked), 'unique_objects': len(rows),
+              'complete_raw_backup': True, 'formal_timing_barrier_released': True, 'receipt': str(receipt)})
+
+if __name__ == '__main__':
