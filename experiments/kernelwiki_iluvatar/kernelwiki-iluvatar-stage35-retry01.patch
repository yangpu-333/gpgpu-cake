+"""Derive an outer resource guard; the 25 frozen mathematical/timing controllers stay unchanged."""
+import ast
+import hashlib
+import json
+from pathlib import Path
+
+HERE = Path(__file__).resolve().parent
+source = HERE / 'browser_formal_retry01.py'
+parent_sha = hashlib.sha256(source.read_bytes()).hexdigest()
+assert parent_sha == '5a59d06701b6e57672e09d5da7968676949007c4cafd05449667aefe8a05113f'
+text = source.read_text(encoding='utf-8')
+changes = []
+
+def replace(old, new, description):
+    global text
+    assert text.count(old) == 1, description
+    text = text.replace(old, new)
+    changes.append(description)
+
+replace("'pid,ppid,user,etimes,pcpu,pmem,comm'", "'pid,ppid,user,etimes,pcpu,pmem,stat,comm'",
+        'Record process state at boundaries')
+replace("if len(fields) >= 7 and int(fields[0]) != os.getpid() and (\n                fields[6].startswith(('python', 'torchrun', 'triton')) or float(fields[4]) >= 10):\n            foreign.append({'pid': int(fields[0]), 'command': fields[6], 'cpu_percent': float(fields[4])})",
+        "if len(fields) >= 8 and not fields[6].startswith('Z') and int(fields[0]) != os.getpid() and (\n                fields[7].startswith(('python', 'torchrun', 'triton')) or float(fields[4]) >= 10):\n            foreign.append({'pid': int(fields[0]), 'command': fields[7], 'process_state': fields[6], 'cpu_percent': float(fields[4])})",
+        'Exclude only nonexecuting zombies; keep every live foreign computation blocking')
+replace("choices=('primary', 'confirmation')", "choices=('primary', 'confirmation', 'resource_confirmation', 'confirmation2')",
+        'Separate resource failure repeat from the unchanged CV repeat policy')
+replace("+ args.round + '-01')", "+ args.round + '-02')", 'New immutable outer wrapper namespace')
+replace("'schema': 'retry01-formal-wrapper-v1'", "'schema': 'retry01-formal-wrapper-v2', 'parent_wrapper_sha256': '" + parent_sha + "'",
+        'Preserve parent resource-wrapper identity')
+replace("assert ROOT.resolve() == Path('/mnt/kda-biv150-stage35-recovery01')",
+        "assert ROOT.resolve() == Path('/mnt/kda-biv150-stage35-recovery01')\n        assert sha(ROOT / 'browser_formal_retry01.py') == '" + parent_sha + "'",
+        'Verify the unchanged original outer wrapper')
+replace("if args.round == 'confirmation':\n            primary = read(model_root / 'performance-004.json')",
+        "if args.round != 'primary':\n            assert args.round != 'confirmation2' or args.model == 'long'\n            prior_base = model_root / 'confirmation' if args.round == 'confirmation2' else model_root\n            primary = read(prior_base / 'performance-004.json')",
+        'Reuse byte-identical controllers in independent result directories')
+replace("assert any(cvs(primary)[arm] >= .1 for arm in ('native', 'control')), 'Repeat policy not triggered'\n            target = model_root / 'confirmation'",
+        "if args.round == 'resource_confirmation':\n                assert args.model == 'long'\n                original_path = ROOT / 'browser-formal-long-retry01-primary-01.json'\n                original = read(original_path)\n                assert original['status'] == 'failed' and original['exit_code'] == 0\n                assert original['error'] == 'Post-run resources busy; timing needs further examination'\n                assert original['occupancy_before']['passed'] is True\n                assert original['occupancy_after']['both_gpus_idle'] is True\n                record['resource_repeat_predecessor_sha256'] = sha(original_path)\n                record['repeat_reason'] = 'First complete timing retained as diagnosis because post-run process ownership was unresolved'\n            else:\n                assert any(cvs(primary)[arm] >= .1 for arm in ('native', 'control')), 'Repeat policy not triggered'\n                record['repeat_reason'] = 'Predeclared native/control CV >= 10%'\n            target = model_root / ('confirmation2' if args.round == 'confirmation2' else 'confirmation')",
+        'Bind the known failed resource gate; require CV threshold for statistical repeats')
+replace("record['exit_code'] = process.returncode\n        record['occupancy_after'] = occupancy()\n        record['cpu_after'] = cpu_boundary_sample()",
+        "record['exit_code'] = process.returncode\n        record['post_training_settle_seconds'] = 5\n        record['cpu_after'] = cpu_boundary_sample()\n        time.sleep(3)\n        record['occupancy_after'] = occupancy()",
+        'Five seconds of process-exit settling, wholly outside retained training timing')
+replace("args.round == 'primary' and any(record['seed_mean_cv'][arm] >= .1",
+        "args.round in ('primary', 'resource_confirmation') and any(record['seed_mean_cv'][arm] >= .1",
+        'Apply the original CV rule to the first accepted resource-repeat collection')
+ast.parse(text)
+target = HERE / 'browser_formal_retry01_v2.py'
+with target.open('x', encoding='utf-8', newline='\n') as stream:
+    stream.write(text)
+record = {'schema': 'outside-timing-resource-wrapper-derivation-v1',
+          'parent_sha256': parent_sha, 'derived_sha256': hashlib.sha256(target.read_bytes()).hexdigest(),
+          'changes': changes, 'frozen_kernel_or_timing_controller_changed': False,
+          'first_failed_wrapper_or_timing_result_overwritten': False}
+with (HERE.parent / 'evidence/formal-resource-wrapper-v2-derivation.json').open('x', encoding='utf-8', newline='\n') as stream:
+    stream.write(json.dumps(record, indent=2) + '\n')
+print(json.dumps(record, indent=2))
