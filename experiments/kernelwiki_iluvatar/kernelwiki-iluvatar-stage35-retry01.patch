+    assert args.idle_acknowledged
+    original = HERE / 'results/receive_retry01_raw_http.py'
+    assert hashlib.sha256(original.read_bytes()).hexdigest() == '9c9637ba7c8698bce92934df48fd14b4a2d96cc763b84cd74e3e6f50181c4dcf'
+    spec = importlib.util.spec_from_file_location('original_receiver_byte_helpers', original)
+    v = importlib.util.module_from_spec(spec); spec.loader.exec_module(v)
+    sha, write, verify = v.sha_file, v.write_new, v.verify_object
+    plan_path = HERE / 'evidence/raw-http-transfer-plan-retry01-01.json'
+    assert sha(plan_path) == PLAN_SHA
+    plan = json.loads(plan_path.read_text(encoding='utf-8'))
+    manifest_path = HERE / 'results/raw-transport-retry01.manifest.json'
+    assert sha(manifest_path) == args.manifest_sha256
