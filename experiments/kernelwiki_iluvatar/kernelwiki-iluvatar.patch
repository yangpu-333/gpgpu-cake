+import copy
+import sys
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+
+ROOT = Path(__file__).resolve().parents[1]
+sys.path.insert(0, str(ROOT / "scripts"))
+
+import query  # noqa: E402
+import validate  # noqa: E402
+
+
+def query_args(architecture):
+    return SimpleNamespace(
+        type=None, tag=None, repo=None, language=None,
+        architecture=architecture, symptom=None, confidence=None, has_code=False,
+    )
+
+
+class IluvatarExtensionTests(unittest.TestCase):
+    def test_bi_v150_filter_and_alias_do_not_import_nvidia_pages(self):
+        pages = query.load_all_pages()
+        direct = {p["fm"]["id"] for p in query.filter_pages(pages, query_args("bi-v150"))}
+        alias = {p["fm"]["id"] for p in query.filter_pages(pages, query_args("Iluvatar BI-V150"))}
+        self.assertEqual(direct, alias)
+        self.assertIn("lang-triton-iluvatar", direct)
+        self.assertIn("exp-bi-v150-corex42-stage0", direct)
+        self.assertNotIn("hw-tma", direct)
+        self.assertNotIn("hw-tcgen05-mma", direct)
+        nvidia = {p["fm"]["id"] for p in query.filter_pages(pages, query_args("sm100"))}
+        self.assertIn("hw-tma", nvidia)
+        self.assertNotIn("lang-triton-iluvatar", nvidia)
+
+    def test_experiment_evidence_is_present_and_tampering_is_rejected(self):
+        path = ROOT / "sources" / "experiments" / "bi-v150-corex42-stage0.md"
+        frontmatter, _ = query.load_frontmatter(path)
+        self.assertEqual("source-experiment", validate.detect_page_type(path, frontmatter))
+        self.assertEqual([], validate.source_experiment_errors(frontmatter, path.relative_to(ROOT)))
+        changed = copy.deepcopy(frontmatter)
+        changed["evidence_files"][0]["sha256"] = "0" * 64
+        self.assertTrue(validate.source_experiment_errors(changed, path.relative_to(ROOT)))
+
+
+if __name__ == "__main__":
+    unittest.main()
