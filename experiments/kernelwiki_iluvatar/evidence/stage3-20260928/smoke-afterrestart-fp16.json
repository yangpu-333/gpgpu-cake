            "shape": [
              8,
              768
            ],
            "access": "write",
            "layout": "row_major_contiguous"
          }
        ],
        "statements": [
          {
            "id": "residual_add",
            "domain": [
              "row",
              "col"
            ],
            "expr": "residual_out[row,col] = x[row,col] + residual[row,col]"
          },
          {
            "id": "sum_squares",
            "domain": [
              "row"
            ],
            "reduction": "col",
            "expr": "sum(residual_out[row,col]^2)"
          },
          {
            "id": "inverse_rms",
            "domain": [
              "row"
            ],
            "expr": "rsqrt(sum_squares[row] / hidden + epsilon)"
          },
          {
            "id": "scale",
            "domain": [
              "row",
              "col"
            ],
            "expr": "output[row,col] = residual_out[row,col] * inverse_rms[row] * weight[col]"
          }
        ],
        "semantics": {
          "residual_out_is_observable": true,
          "reduction_precision": "fp32_accumulate",
          "reduction_reassociation": "not_assumed_legal",
