+#!/usr/bin/env python3
+"""Install an external skill into this checkout's project-level Claude path.
+
+The skill content stays in its own repository. This command copies a prepared
+skill tree, excluding Git metadata, into ``.claude/skills``. It never writes to
+the user's global skill directory or changes KDA's pinned submodules.
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import re
+import shutil
+import stat
+import uuid
+from pathlib import Path
+
+
+REPO_ROOT = Path(__file__).resolve().parents[1]
+MARKER = ".kda-managed-skill.json"
+SKIP_NAMES = {".git", "__pycache__"}
+
+
+def source_files(root):
+    for path in sorted(root.rglob("*")):
+        relative = path.relative_to(root)
+        if any(part in SKIP_NAMES for part in relative.parts) or path.suffix == ".pyc":
+            continue
+        if path.is_symlink():
+            raise ValueError(f"skill source contains a symlink: {relative}")
+        if path.is_file():
+            yield relative
+
+
+def digest_tree(root):
+    checksums = {}
+    for relative in source_files(root):
+        if relative.as_posix() == MARKER:
+            continue
+        checksums[relative.as_posix()] = hashlib.sha256((root / relative).read_bytes()).hexdigest()
+    return checksums
+
+
+def is_reparse_point(path):
+    info = path.lstat()
+    reparse_flag = getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0)
+    return path.is_symlink() or bool(getattr(info, "st_file_attributes", 0) & reparse_flag)
+
+
+def require_managed_directory(path, destination, name):
+    if is_reparse_point(path) or not path.is_dir():
+        raise ValueError(f"refusing to replace a link or non-directory: {path}")
+    if path.parent.resolve() != destination.resolve():
+        raise ValueError(f"target is outside destination: {path}")
+    marker = path / MARKER
+    if not marker.is_file():
+        raise ValueError(f"refusing to replace an unmanaged skill: {path}")
+    metadata = json.loads(marker.read_text(encoding="utf-8"))
+    if metadata.get("name") != name:
+        raise ValueError(f"invalid managed-skill marker: {path}")
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--source", type=Path, required=True, help="prepared skill directory")
+    parser.add_argument("--name", required=True, help="project skill name")
+    parser.add_argument("--destination", type=Path, default=REPO_ROOT / ".claude" / "skills")
+    parser.add_argument("--check", action="store_true", help="verify an existing installation")
+    parser.add_argument("--replace", action="store_true", help="update a previously managed copy")
+    args = parser.parse_args()
+    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", args.name):
+        parser.error("name must be a simple skill directory name")
+    if args.check and args.replace:
+        parser.error("--check and --replace cannot be combined")
+
+    source = args.source.resolve(strict=True)
+    if not source.is_dir() or not (source / "SKILL.md").is_file():
+        parser.error("source must be a prepared skill containing SKILL.md")
+    expected = digest_tree(source)
+    destination = args.destination.resolve()
+    target = destination / args.name
+
+    if args.check:
+        if not target.exists() or is_reparse_point(target):
+            raise ValueError(f"missing or linked project skill: {target}")
+        require_managed_directory(target, destination, args.name)
+        if digest_tree(target) != expected:
+            raise ValueError(f"skill content differs from source: {target}")
+        print(f"verified {args.name}: {len(expected)} files at {target}")
+        return
+
+    destination.mkdir(parents=True, exist_ok=True)
+    if target.exists() or target.is_symlink():
+        if is_reparse_point(target):
+            raise ValueError(f"refusing to overwrite an existing link: {target}")
+        require_managed_directory(target, destination, args.name)
+        if digest_tree(target) == expected:
+            print(f"already current: {target}")
+            return
+        if not args.replace:
+            raise ValueError(f"managed skill differs; pass --replace: {target}")
+
+    # Inherit destination ACLs. Windows tempfile.mkdtemp creates a private ACL
+    # that can prevent another local account (including Claude Code) from
+    # reading the installed skill after the directory is renamed into place.
+    temp = destination / f".{args.name}-{uuid.uuid4().hex}"
+    temp.mkdir()
+    backup = None
+    try:
+        for relative in expected:
+            output = temp / relative
+            output.parent.mkdir(parents=True, exist_ok=True)
+            shutil.copy2(source / relative, output)
+        (temp / MARKER).write_text(
+            json.dumps({"name": args.name, "file_count": len(expected)}, sort_keys=True) + "\n",
+            encoding="utf-8",
+        )
+        if digest_tree(temp) != expected:
+            raise RuntimeError("copied skill failed its hash check")
+        if target.exists():
+            backup = destination / f".{args.name}-previous-{os.getpid()}"
+            if backup.exists():
+                raise ValueError(f"backup path already exists: {backup}")
+            target.rename(backup)
+        try:
+            temp.rename(target)
+        except BaseException:
+            if backup is not None:
+                backup.rename(target)
+                backup = None
+            raise
+        if backup is not None:
+            require_managed_directory(backup, destination, args.name)
+            shutil.rmtree(backup)
+        print(f"installed {args.name}: {len(expected)} files at {target}")
+    finally:
+        if temp.exists():
+            shutil.rmtree(temp)
+
+
+if __name__ == "__main__":
+    main()
