+"""Safety checks for checkout-local external skill installation."""
+
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+
+SCRIPT = Path(__file__).resolve().parents[1] / "tools" / "load_external_skill.py"
+
+
+class ExternalSkillLoaderTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        root = Path(self.temp.name)
+        self.source = root / "source"
+        self.destination = root / "project" / ".claude" / "skills"
+        self.source.mkdir()
+        (self.source / "SKILL.md").write_text("---\nname: fixture\n---\n", encoding="utf-8")
+        (self.source / "wiki").mkdir()
+        (self.source / "wiki" / "page.md").write_text("first\n", encoding="utf-8")
+        (self.source / ".git").mkdir()
+        (self.source / ".git" / "config").write_text("local metadata\n", encoding="utf-8")
+
+    def command(self, *extra):
+        return subprocess.run(
+            [sys.executable, str(SCRIPT), "--source", str(self.source),
+             "--name", "fixture", "--destination", str(self.destination), *extra],
+            capture_output=True, text=True,
+        )
+
+    def test_install_check_and_managed_update(self):
+        self.assertEqual(self.command().returncode, 0)
+        target = self.destination / "fixture"
+        self.assertTrue((target / "SKILL.md").is_file())
+        self.assertFalse((target / ".git").exists())
+        self.assertEqual(self.command("--check").returncode, 0)
+        (self.source / "wiki" / "page.md").write_text("second\n", encoding="utf-8")
+        self.assertNotEqual(self.command("--check").returncode, 0)
+        self.assertNotEqual(self.command().returncode, 0)
+        self.assertEqual(self.command("--replace").returncode, 0)
+        self.assertEqual(self.command("--check").returncode, 0)
+        self.assertEqual((target / "wiki" / "page.md").read_text(), "second\n")
+
+    def test_unmanaged_directory_is_never_replaced(self):
+        target = self.destination / "fixture"
+        target.mkdir(parents=True)
+        sentinel = target / "keep.txt"
+        sentinel.write_text("user content", encoding="utf-8")
+        self.assertNotEqual(self.command("--replace").returncode, 0)
+        self.assertEqual(sentinel.read_text(), "user content")
+
+
+if __name__ == "__main__":
+    unittest.main()
